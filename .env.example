# Local development only. Copy to .env; never use these values in production.
# Keep database passwords URL-safe (letters and numbers) because they are used in connection URLs.
POSTGRES_PASSWORD=localownerpasswordchange
IREC_DB_APP_PASSWORD=localapppasswordchange
FRONTEND_PORT=3100
POSTGRES_PORT=5432
IREC_ENV=development
PUBLIC_ORIGIN=http://localhost:3100

# Optional Meta WhatsApp Cloud API values. Leave blank to keep WhatsApp verification/sending disabled.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
